---
// The four editions. A download button appears only for an edition that a verified public release
// contains (src/data/release.json); everything else says "Coming soon". The visitor's platform is
// suggested by src/scripts/downloads.ts, which never hides any edition.
import { editions, info, sourceAsset, megabytes, releaseDate, hasEditors, type Edition } from '../data/editions';
interface Props {
  compact?: boolean;
}
const { compact = false } = Astro.props;
const symbol: Record<string, string> = {
  'macos-universal': '⌘',
  'macos-apple-silicon': '⌘',
  'windows-x64': '⊞',
  'linux-x86_64': '◆',
};
const label: Record<string, string> = {
  'macos-universal': 'Download for Mac — Universal',
  'macos-apple-silicon': 'Download for Mac — Apple Silicon',
  'windows-x64': 'Download for Windows',
  'linux-x86_64': 'Download for Linux',
};
const pending = (e: Edition) =>
  e.id === 'macos-universal'
    ? 'Until then, Intel Macs have no edition: the Apple Silicon build does not run on them.'
    : 'Version 2.3.0 is being finished and tested. It will appear here once it is verified.';
---

<div class:list={['edition-picker', { compact }]} data-edition-picker>
  <p class="edition-suggestion" data-suggestion hidden aria-live="polite"></p>
  <div class="download-grid four">
    {editions.map((e) => {
      const i = info[e.id];
      return (
        <article class="download-card" data-edition={e.id} data-available={String(e.available)}>
          <span class="recommend-badge" aria-hidden="true">Recommended</span>
          <span class="platform-symbol" aria-hidden="true">
            {symbol[e.id]}
          </span>
          <h3>
            {i.name}
            {e.available && e.preview && <span class="preview-badge">Preview</span>}
          </h3>
          <p>{i.tagline}</p>
          <dl class="edition-specs mono">
            <div>
              <dt>Architecture</dt>
              <dd>{i.arch}</dd>
            </div>
            <div>
              <dt>Requires</dt>
              <dd>{i.requires}</dd>
            </div>
            {!compact && (
              <div>
                <dt>Package</dt>
                <dd>{i.format}</dd>
              </div>
            )}
          </dl>
          {e.available ? (
            <>
              <a class="button download-button" href={e.url} download>
                {label[e.id]}
              </a>
              <p class="download-meta">
                Version {e.version} · {megabytes(e.size)} · {releaseDate(e.published)}
              </p>
              {!compact && (
                <details>
                  <summary>SHA-256 checksum</summary>
                  <code class="checksum">{e.sha256}</code>
                  <span class="file-name mono">{e.name}</span>
                </details>
              )}
              {e.extras.map((x) => (
                <div class="download-alt">
                  <p>
                    Prefer no installer? <a href={x.url}>Portable ZIP</a> ({megabytes(x.size)})
                  </p>
                  {!compact && (
                    <details>
                      <summary>Portable SHA-256</summary>
                      <code class="checksum">{x.sha256}</code>
                    </details>
                  )}
                </div>
              ))}
              {!hasEditors(e) && (
                <p class="download-note">
                  Version {e.version} has the Viewer, MARK, PDF Tools and PowerPoint export. The Image,
                  Vector and Edit PDF workspaces arrive here with 2.3.0, which is being finished and tested.
                </p>
              )}
              {e.preview && (
                <p class="download-note">
                  {e.id === 'windows-x64'
                    ? 'Preview: built and tested automatically on Windows Server, not yet on an everyday Windows 10 or 11 PC.'
                    : 'Preview: please report anything that does not work as expected.'}
                </p>
              )}
            </>
          ) : (
            <>
              <span class="status">Coming soon</span>
              <p class="download-note">{pending(e)}</p>
            </>
          )}
        </article>
      );
    })}
  </div>
  {!compact && (
    <div class="source-row">
      <span class="platform-symbol" aria-hidden="true">〈/〉</span>
      <div>
        <h3>Source code</h3>
        <p>Free to inspect and build. GNU AGPL v3 or later.</p>
      </div>
      {sourceAsset ? (
        <div class="source-actions">
          <a class="text-link" href={sourceAsset.url}>
            Source {sourceAsset.version} · {megabytes(sourceAsset.size)} ↓
          </a>
          <details>
            <summary>SHA-256</summary>
            <code class="checksum">{sourceAsset.sha256}</code>
          </details>
        </div>
      ) : (
        <span class="status">Published with the first release</span>
      )}
    </div>
  )}
</div>
<script>
  import '../scripts/downloads';
</script>
