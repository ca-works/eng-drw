---
// The review marks on the sample blade drawing, at the coordinates where the real MARK window put them
// (tools/demo/make_review_slide.py writes src/data/review.json). They live inside the drawing's own
// SVG, in its viewBox units, so they scale with the sheet and stay on their features at any width.
// Styling follows the app: a red ring with a black number, red shapes, a yellow highlighter.
// `data-at` is the step of the PowerPoint story that shows a mark; `--delay` is its place in the hero.
import review from '../data/review.json';
const r = review.bubble_diameter / 2;
const ringStroke = review.bubble_diameter * 0.075;
const [x0, y0, x1, y1] = review.ring;
const cx = (x0 + x1) / 2,
  cy = (y0 + y1) / 2,
  rx = (x1 - x0) / 2,
  ry = (y1 - y0) / 2;
const ring = `M${cx - rx} ${cy}A${rx} ${ry} 0 1 1 ${cx + rx} ${cy}A${rx} ${ry} 0 1 1 ${cx - rx} ${cy}`;
const arrow = ([[ax, ay], [bx, by]]: number[][]) => {
  const a = Math.atan2(by - ay, bx - ax);
  const head = 13;
  const at = (d: number, side: number) => `${bx - d * Math.cos(a) - side * Math.sin(a)} ${by - d * Math.sin(a) + side * Math.cos(a)}`;
  return { shaft: `M${ax} ${ay}L${at(head - 1, 0)}`, head: `M${bx} ${by}L${at(head, 6)}L${at(head, -6)}Z` };
};
const arrows = review.arrows.map(arrow);
const [h0, h1] = review.highlight;
const steps = { ring: 1, bubble1: 1, later: 3 };
const delays = { ring: 0, bubble1: 0.55, arrow2: 1.25, bubble2: 1.7, highlight: 2.35, arrow3: 2.8, bubble3: 3.2 };
---

<g class="mark-layer seq" aria-hidden="true">
  <path
    class="m-draw m-highlight"
    pathLength="1"
    d={`M${h0[0]} ${h0[1]}L${h1[0]} ${h1[1]}`}
    data-at={steps.later}
    style={`--delay:${delays.highlight}s`}
  />
  <path class="m-draw m-line" pathLength="1" d={ring} data-at={steps.ring} style={`--delay:${delays.ring}s`} />
  <path class="m-draw m-line" pathLength="1" d={arrows[0].shaft} data-at={steps.later} style={`--delay:${delays.arrow2}s`} />
  <path class="m-fade m-head" d={arrows[0].head} data-at={steps.later} style={`--delay:${delays.arrow2 + 0.4}s`} />
  <path class="m-draw m-line" pathLength="1" d={arrows[1].shaft} data-at={steps.later} style={`--delay:${delays.arrow3}s`} />
  <path class="m-fade m-head" d={arrows[1].head} data-at={steps.later} style={`--delay:${delays.arrow3 + 0.4}s`} />
  {
    review.bubbles.map((b) => (
      <g transform={`translate(${b.x} ${b.y})`}>
        <g
          class="m-pop"
          data-at={b.number === 1 ? steps.bubble1 : steps.later}
          style={`--delay:${delays[`bubble${b.number}` as 'bubble1' | 'bubble2' | 'bubble3']}s`}
        >
          <circle r={r} fill="#fff" stroke="#e81a1e" stroke-width={ringStroke} />
          <text
            text-anchor="middle"
            dy="0.36em"
            fill="#000"
            font-family="Inter Variable, Arial, sans-serif"
            font-size={r * 1.34}
            font-weight="700"
          >
            {b.number}
          </text>
        </g>
      </g>
    ))
  }
</g>
