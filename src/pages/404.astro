---
import Layout from '../layouts/Layout.astro';
import { url } from '../data/site';
---

<Layout title="Sheet not found">
  <div class="container">
    <header class="page-hero">
      <div class="section-tag">ENG—404 / MISSING SHEET</div>
      <h1>
        One detail
        <br />
        <span>we couldn’t find.</span>
      </h1>
      <p>This page may have moved. Let’s get you back to the workspace.</p>
      <a class="button" style="margin-top:30px" href={url()}>
        Back to the drawing ↗
      </a>
    </header>
  </div>
</Layout>
