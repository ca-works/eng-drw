---
import { allEditorsReleased, universalReleased, nativeEditorsReleased, windows231, linux231 } from '../data/editions';
import Layout from '../layouts/Layout.astro';
import { url } from '../data/site';
import release from '../data/release.json';
const r234 = release.releases.find((r) => r.version === '2.3.4');
const r233 = release.releases.find((r) => r.version === '2.3.3');
const appleSilicon233 = release.editions.some((e) => e.id === 'macos-apple-silicon' && e.version === '2.3.3');
const windows233 = Boolean(r234) || release.editions.some((e) => e.id === 'windows-x64' && e.version === '2.3.3');
const r232 = (release.releases as { version: string; url: string; published: string }[]).find((r) => r.version === '2.3.2');
const r231 = (release.releases as { version: string; url: string; published: string }[]).find((r) => r.version === '2.3.1');
const r230 = (release.releases as { version: string; url: string; published: string }[]).find((r) => r.version === '2.3.0');
const date = (iso: string) => new Date(iso).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
---

<Layout
  title="Thoughtful improvements"
  description="Release status and development highlights for ENG Drawing Viewer."
>
  <div class="container">
    <header class="page-hero">
      <div class="section-tag">CHANGELOG</div>
      <h1>
        Better, with
        <br />
        <span>every detail.</span>
      </h1>
      <p>A record of the work going into a clearer engineering workspace.</p>
    </header>
    <article class="page-content prose">
      {r232 && (
        <div class="callout">
          <strong>Version 2.3.2 · {date(r232.published)}</strong>
          <br />
          Windows (as a one-file installer), macOS Universal and macOS Apple Silicon, on the <a href={url('download/')}>download page</a> and the{' '}
          <a href={r232.url}>GitHub release</a>. Linux stays at 2.3.1.
        </div>
      )}
      {r231 && (
        <div class="callout">
          <strong>Version 2.3.1 · {date(r231.published)}</strong>
          <br />
          {windows231 && linux231
            ? 'For Macs with Apple silicon, Windows and Linux, with the source code, on the '
            : 'For Macs with Apple silicon' + (linux231 ? ' and Linux' : windows231 ? ' and Windows' : '') + ', with the source code, on the '}
          <a href={url('download/')}>download page</a> and the <a href={r231.url}>GitHub release</a>.
          {!(windows231 && linux231) && (linux231
            ? ' Windows stays at 2.3.0 until its 2.3.1 build is verified.'
            : windows231
              ? ' Linux stays at 2.3.0 until its 2.3.1 build is verified.'
              : ' Windows and Linux stay at 2.3.0 until their 2.3.1 builds are verified.')}
        </div>
      )}
      <div class="callout">
        {r230 ? (
          <>
            <strong>Version 2.3.0 · {date(r230.published)}</strong>
            <br />
            {allEditorsReleased
              ? 'Mac, Windows and Linux, with the source code, on the '
              : nativeEditorsReleased
                ? 'Macs with Apple silicon, Windows and Linux, with the source code, on the '
                : 'Macs with Apple silicon first, with the source code, on the '}
            <a href={url('download/')}>download page</a> and the <a href={r230.url}>GitHub release</a>.
            {!allEditorsReleased && (nativeEditorsReleased
              ? ' A Universal Mac edition for Intel Macs is coming soon.'
              : ' Windows and Linux 2.3.0 are being finished; Windows 2.2.1 stays available as a Preview.')}
          </>
        ) : (
          <>
            <strong>Version 2.2.0 · First public release · 28 October 2026</strong>
            <br />
            The Mac app and its complete source code are on the{' '}
            <a href={url('download/')}>download page</a> and the{' '}
            <a href="https://github.com/ca-works/eng-drawing-viewer/releases/tag/v2.2.0">GitHub release</a>.
            Windows 2.2.1 is available as a Preview.
          </>
        )}
      </div>
      {r234 && (
        <>
          <h2>2.3.4 · {date(r234.published)} · Windows</h2>
          <ul>
            <li>Standards is now Reference, with a simpler toolbar and arrows for switching documents.</li>
            <li>Scroll continuously through a PDF. Pages render as they come into view.</li>
            <li>Add text and undo or redo completed text, pen, highlight, and eraser edits across pages in the active document.</li>
          </ul>
          <p><a href={url('download/')}>Download for Windows</a> or read the <a href={r234.url}>release notes</a>.</p>
        </>
      )}
      {r233 && (
        <>
          <h2>2.3.3 · {date(r233.published)} · macOS Universal{appleSilicon233 ? ' and Apple Silicon' : ''}{windows233 ? ', Windows' : ''}</h2>
          <ul>
            <li>Checkmark, cross, and dated PASS and FAIL stamps in MARK, with annotation display in VIEWER.</li>
            <li>Dockable Standards Reference with temporary annotations and local document previews.</li>
            <li>On macOS, send drawings to Pages and Keynote or literal table values to Numbers.</li>
            <li>Image layer and background removal improvements, plus preceding-slide backgrounds in PowerPoint export.</li>
            {windows233 && <li>On Windows, use the one-file installer to update from 2.3.2 without administrator rights. Word and Excel previews require local LibreOffice.</li>}
          </ul>
          <p><a href={url('download/')}>{windows233 ? 'Download for Windows or macOS' : 'Download for macOS'}</a> or read the <a href={r233.url}>release notes</a>.</p>
        </>
      )}
      {r232 && (
        <>
          <h2>2.3.2 · {date(r232.published)} · Windows, macOS Universal, macOS Apple Silicon</h2>
          <h3>New</h3>
          <ul>
            <li>
              <strong>One-file installer (Windows).</strong> Windows now downloads as a single Setup program that installs for
              your user (no administrator rights), with a Start menu entry, an optional desktop shortcut and a normal
              uninstaller.
            </li>
            <li>
              <strong>Select and resize markup in MARK.</strong> Click an annotation to get resize handles; drag them to
              resize, and hold Shift to keep proportions. Drag to move.
            </li>
            <li>
              <strong>Select several at once.</strong> Drag a selection rectangle on empty space, or Shift-click to add or
              remove objects, then move, delete or copy them together.
            </li>
            <li>
              <strong>Copy and paste markup between drawings.</strong> Ctrl+C (⌘C on Mac) copies the selected annotations as editable
              objects and Ctrl+V (⌘V) pastes them on the same drawing or on another one. Pasted callouts continue the
              numbering and keep their comments. With nothing selected, Ctrl+C still copies the marked page as an image.
            </li>
          </ul>
        </>
      )}
      {r231 && (
        <>
          <h2>2.3.1 · {date(r231.published)} · macOS Apple Silicon{windows231 ? ', Windows' : ''}{linux231 ? ', Linux' : ''}</h2>
          <p>
            Image Editor composition, accuracy and interface fixes.
            {windows231 && linux231
              ? ' Published for Macs with Apple silicon, Windows and Linux. Image projects with transformed layers are saved as ENGIMG version 2, which 2.3.0 cannot open; the three 2.3.1 editions open the same projects.'
              : ' Published for Macs with Apple silicon' + (linux231 ? ' and Linux' : windows231 ? ' and Windows' : '') + '; ' +
                (linux231 ? 'the Windows edition is' : windows231 ? 'the Linux edition is' : 'the Windows and Linux editions are') +
                ' still at 2.3.0 and ' + (linux231 || windows231 ? 'does' : 'do') + ' not have these changes yet.'}
          </p>
          <h3>New</h3>
          <ul>
            <li><strong>Images as layers:</strong> drop, paste or import images as layers, then stack, move, scale and rotate them with handles, snapping and numeric fields. Layers keep their original pixels, so repeated transforms never compound blur.</li>
            <li><strong>Clipboard:</strong> copy, copy merged, cut, paste as a new layer, and layer via copy or cut with the familiar shortcuts. Copies keep masks, opacity and blend mode inside the editor and reach other apps as PNG or TIFF.</li>
            <li><strong>Paint Bucket</strong> with tolerance, contiguous and anti-aliasing options, selection limits and fill on a new layer.</li>
          </ul>
          <h3>Better</h3>
          <ul>
            <li><strong>Magic Eraser</strong> tells a light subject from a light backdrop more reliably and stops at visible edges. On a synthetic test figure the match to the true subject rose from 52.7 % to 98–99.8 %; real photographs vary.</li>
            <li><strong>Automatic background removal</strong> uses edge-aware seeding and full-resolution edge refinement. It is a helper, not a guarantee: difficult subjects still need the mask tools.</li>
            <li>The window moves by dragging any empty part of the title bar, dropdown labels and arrows no longer overlap, and the View/Grid/Snap/Rulers bar folds into the View menu when space is short.</li>
            <li>The welcome screen's app icon no longer touches the “Open a folder of drawings” heading.</li>
          </ul>
          <h3>Compatibility</h3>
          <p>Projects with transformed layers are saved as ENGIMG version 2, which 2.3.0 cannot open. Other projects remain version 1.</p>
        </>
      )}
      <h2>2.3.0 · {r230 ? date(r230.published) : 'in preparation'}</h2>
      <p>
        {r230 ? (
          allEditorsReleased ? (
            <>One version for every platform, built from the same source: <a href={r230.url}>GitHub release</a>.</>
          ) : nativeEditorsReleased ? (
            <>
              Published in stages. The <a href={r230.url}>Apple Silicon, Windows and Linux editions are out</a>;
              a Universal Mac edition is coming soon.
            </>
          ) : (
            <>
              Published in stages. The <a href={r230.url}>Apple Silicon edition is out</a>; Windows and Linux
              follow once they are verified, and a Universal Mac edition is coming soon.
            </>
          )
        ) : (
          'One version for every platform, built from the same source. It is being tested and audited and will be listed on the download page once it is released.'
        )}
      </p>
      <h3>New</h3>
      <ul>
        <li>
          <strong>Three new workspaces</strong>, each on its own tab beside the
          Viewer and PDF Tools: <strong>Edit PDF</strong> (text boxes, shapes,
          images, notes, real redaction, page crop and rotate, Save As),
          <strong>Image</strong> (layers, masks, selections, Magic Eraser,
          automatic background removal, healing, clone, exports to a target
          file size) and <strong>Vector</strong> (millimetre geometry, Bézier
          and node editing, booleans, SVG and DXF, raster tracing).
        </li>
        <li>
          <strong>Four editions</strong> from one source: macOS Apple Silicon,
          Windows x64 and a new Linux x86-64 AppImage ({nativeEditorsReleased ? 'all out now' : 'Apple Silicon out now'}),
          and macOS Universal for Intel and Apple Silicon Macs ({universalReleased ? 'out now' : 'coming soon'}).
        </li>
        <li>Optional offline AI model packs for subject selection, installed by you; none is bundled.</li>
        <li>The Windows improvements of 2.2.1 reach every platform.</li>
      </ul>
      <h3>Smaller</h3>
      <ul>
        <li>
          OpenCV is built from source with only the parts the app uses, on every edition. The
          Windows ZIP shrinks from 162 MB to 128 MB and the Linux AppImage from 177 MB to 134 MB,
          and the packages no longer contain FFmpeg (or, on Linux, OpenSSL 1.1.1k). No features changed.
        </li>
      </ul>
      <h3>Faster</h3>
      <ul>
        <li>The interface stays responsive while pages render on busy machines.</li>
      </ul>
      <h2>2.2.1 for Windows (Preview)</h2>
      <p>
        The rebuilt Windows version, for Windows 10 and 11 (64-bit). It has the
        same viewer, MARK, PDF tools and PowerPoint export as the Mac app, and
        is a Preview until it has been tried on everyday PCs.
      </p>
      <ul>
        <li>A per-user installer (no administrator rights, Start menu, "Open with") and a portable ZIP.</li>
        <li>Title bars and controls follow Windows 11's look and your light or dark theme.</li>
        <li>Make Searchable (OCR) works out of the box with seven languages.</li>
        <li>Spelling uses Windows' own spell checker, and words you add are remembered.</li>
        <li>iPhone HEIC photos open once Microsoft's free HEIF and HEVC extensions are installed.</li>
        <li>Send slides straight into a presentation open in PowerPoint.</li>
        <li>Open drawings aren't locked, so you can still rename or replace them in Explorer.</li>
        <li>Opening a file while the app is running brings it to the existing window.</li>
        <li>Keyboard shortcuts that work with every keyboard layout, plus Ctrl+, F1 and F5.</li>
        <li>Offline like the Mac app: no network connections, no telemetry.</li>
      </ul>
      <p>The shared improvements reached the Mac in 2.3.0.</p>
      <h2>2.2.0</h2>
      <p>
        The first public release. ENG Drawing Viewer becomes free software under
        the GNU Affero General Public License v3 or later.
      </p>
      <h3>New</h3>
      <ul>
        <li>
          <strong>About</strong> shows the licence and where to get the source
          code, with the full licence and third-party notices one click away.
        </li>
        <li>
          A new <strong>spelling dictionary</strong> of about 140,000 English
          words, American and British.
        </li>
        <li>
          <strong>PDF → Images</strong> lowers the resolution for very large
          sheets instead of failing, and tells you.
        </li>
      </ul>
      <h3>Privacy and security</h3>
      <ul>
        <li>The app refuses network connections in its own code, in every process.</li>
        <li>
          Redact and Remove Metadata also clear bookmarks, comments,
          attachments, links and form fields; redaction also removes linework
          crossing the redacted text.
        </li>
        <li>PDF → Excel keeps text as text: no formulas or links can sneak in.</li>
        <li>Protect generates a strong random permissions password if you leave it empty.</li>
        <li>Tools refuse to write over an original, even through links or different capitalisation.</li>
        <li>Extreme page and image sizes are checked before memory is used.</li>
        <li>LibreOffice conversions run contained and stop completely on timeout.</li>
        <li>Atomic saves, and temporary files are always cleaned up.</li>
      </ul>
      <h3>Under the hood</h3>
      <ul>
        <li>Built with Python 3.13 and hash-checked dependencies.</li>
        <li>Runs on macOS 14.4 or later with Apple silicon, tested on macOS 14, 15, 26 and 27.</li>
        <li>Built from the published source; two separate builds are byte-for-byte identical.</li>
      </ul>
      <h2>Earlier development</h2>
      <p>
        Versions 2.0 and 2.1 were private builds. They rebuilt the app around a
        fast, sharp tiled viewer and the MARK workspace, and added:
      </p>
      <ul>
        <li>a PDF Tools workspace with 32 offline tools, including Organize Pages and Compare Drawings;</li>
        <li>Scan with iPhone through Continuity Camera on Mac;</li>
        <li>images (including iPhone photos) as one-page documents;</li>
        <li>drag and drop onto the window, the PowerPoint queue and the tools;</li>
        <li>saving a marked page as a PDF with vector markup, and exporting the queue as one PDF.</li>
      </ul>
      <a class="text-link" href={url('download/')}>
        Check availability ↗
      </a>
      <p>
        <a href={url('rss.xml')}>Subscribe to the update feed ↗</a>
      </p>
    </article>
  </div>
</Layout>
