---
import Layout from '../layouts/Layout.astro';
import Downloads from '../components/Downloads.astro';
import { site, url } from '../data/site';
import release from '../data/release.json';
const released = release.status === 'available';
const v = release.version;
const win = (release.assets as { platform: string; version?: string }[]).find((a) => a.platform === 'windows');
---

<Layout
  title={released ? `Download ENG Drawing Viewer ${v}` : "A better workspace is on its way"}
  description="Find release availability, installation instructions and complete source information for ENG Drawing Viewer."
>
  <div class="container">
    <header class="page-hero">
      <div class="section-tag">GET ENG DRAWING VIEWER</div>
      <h1>
        A better workspace.
        <br />
        <span>Yours, for free.</span>
      </h1>
      <p>
        {released
          ? `Version ${v} for Mac is here, free and open source${win ? `, with a ${win.version} Preview for Windows` : ''}. No account, subscription or cloud workspace required.${win ? '' : ' Windows is being rebuilt and will follow.'}`
          : 'The first public release is being prepared. Choose your platform below for the current status. No account, subscription or cloud workspace required.'}
      </p>
    </header>
    <div class="page-content">
      <Downloads />
      <div class="prose">
        <h2>Installing on a Mac</h2>
        <p>Needs a Mac with Apple silicon (M1 or newer) and macOS 14.4 or later.</p>
        <ol>
          <li>Download the disk image (DMG) above and open it.</li>
          <li>Drag ENG Drawing Viewer onto Applications.</li>
          <li>
            Open the app. Because it's free software that isn't notarized by
            Apple, macOS first says it could not verify it. Click
            <strong>Done</strong>, open <strong>System Settings › Privacy &amp;
            Security</strong>, click <strong>Open Anyway</strong> next to the
            message about ENG Drawing Viewer, and confirm. You only do this once.
          </li>
        </ol>
        <p>
          Please don't turn off Gatekeeper for your whole Mac; Open Anyway is
          enough. A ZIP of the app and every other release file are on the{' '}
          <a href={`${site.appRepo}/releases`}>GitHub release page ↗</a>.
        </p>
        <p>
          <a href={`${site.appRepo}/issues`}>
            Questions or problems? Ask on GitHub ↗
          </a>
        </p>
        {win && (
          <>
            <h2>Installing on Windows (Preview)</h2>
            <p>Needs Windows 10 or 11, 64-bit. No administrator rights are needed.</p>
            <ol>
              <li>
                Download the installer above and run it. It installs for your
                user account only and adds a Start menu shortcut.
              </li>
              <li>
                Because the app isn't code-signed, Windows SmartScreen may say
                it protected your PC. Click <strong>More info</strong>, check
                that the file is ENG Drawing Viewer, then click
                <strong>Run anyway</strong>.
              </li>
              <li>
                Prefer not to install? Unzip the portable ZIP first (don't run
                it from inside the ZIP) and open <code>ENG Drawing Viewer.exe</code>.
              </li>
            </ol>
            <p>
              This is a Preview: it has been built and tested automatically on
              Windows Server 2022 and 2025, but not yet on an everyday PC. Please
              report anything that doesn't look or work right.
            </p>
          </>
        )}
        <h2>Verify a download</h2>
        <p>
          Every file has a SHA-256 checksum, shown on its card above and in{' '}
          <code>SHA256SUMS.txt</code> on the release page. In Terminal, run{' '}
          <code>shasum -a 256 ~/Downloads/ENG-Drawing-Viewer-*.dmg</code> and
          compare the whole result.{win && (
            <>
              {' '}On Windows, use PowerShell:{' '}
              <code>Get-FileHash $HOME\Downloads\ENG-Drawing-Viewer-*-Windows-x64-Setup.exe</code>.
            </>
          )}
        </p>
        <h2>Visiting from your phone?</h2>
        <p>
          This is a desktop application. Send this page to your computer when
          you’re ready.
        </p>
        <button class="button" data-share>
          Share this page ↗
        </button>
        <p data-share-status aria-live="polite"></p>
        <h2>Build it yourself</h2>
        <p>
          The complete source code is free under the GNU AGPL v3 or later: the
          source card above, or the{' '}
          <a href={site.appRepo}>repository on GitHub ↗</a>. Building needs an
          Apple silicon Mac and one command; the release itself is built that
          way, and two builds produce byte-identical apps. The unmodified
          source of every copyleft library inside the app is attached to the
          release too.
        </p>
        <a href={url('support/')} class="text-link">
          Installation questions? Visit support ↗
        </a>
      </div>
    </div>
  </div>
</Layout>
