---
import Layout from '../layouts/Layout.astro';
import Downloads from '../components/Downloads.astro';
import { site, url } from '../data/site';
import release from '../data/release.json';
import { edition, compare } from '../data/editions';
const released = release.status === 'available';
const mac = edition('macos-apple-silicon');
const universal = edition('macos-universal');
const win = edition('windows-x64');
const linux = edition('linux-x86_64');
const winZip = win.available && compare(win.version, '2.3.0') >= 0;
const all230 = [mac, universal, win, linux].every((e) => e.available && compare(e.version, '2.3.0') >= 0);
---

<Layout
  title={all230 ? 'Download ENG Drawing Viewer 2.3.0' : released ? 'Download ENG Drawing Viewer' : 'A better workspace is on its way'}
  description="Download ENG Drawing Viewer for Mac (Universal or Apple Silicon), Windows or Linux: versions, requirements, checksums and installation instructions."
>
  <div class="container">
    <header class="page-hero">
      <div class="section-tag">GET ENG DRAWING VIEWER</div>
      <h1>
        A better workspace.
        <br />
        <span>Yours, for free.</span>
      </h1>
      <p>
        {all230
          ? 'Version 2.3.0 for Mac, Windows and Linux: free and open source, with the new Image, Vector and Edit PDF workspaces. No account, subscription or cloud workspace required.'
          : released
            ? `Version ${mac.available ? mac.version : ''} for Macs with Apple silicon is here, with the new Image, Vector and Edit PDF workspaces.${win.available ? ` Windows ${win.version}${win.preview ? ' stays available as a Preview' : ' is available'}.` : ''} Windows and Linux 2.3.0 are being finished, and a Universal Mac edition is coming soon. No account, subscription or cloud workspace required.`
            : 'The first public release is being prepared. Choose your platform below for the current status. No account, subscription or cloud workspace required.'}
      </p>
    </header>
    <div class="page-content">
      <h2 class="sr-only">Choose your edition</h2>
      <Downloads />
      <div class="prose">
        <h2 id="which-mac">Which Mac edition?</h2>
        <p>
          <strong>Apple Silicon</strong> is a native build for Macs with an M1
          chip or newer, on macOS 14.4 or later. It does not run on Intel Macs.
          <strong>Universal</strong>, one application for both Intel and Apple
          Silicon Macs, has the same features and {universal.available ? 'needs the same macOS' : 'is coming soon'}.
          To check your Mac, choose Apple menu › About This Mac: “Chip: Apple
          M…” means Apple silicon, “Processor: … Intel” means Intel.
        </p>

        <h2>Installing on a Mac</h2>
        <ol>
          <li>Download the disk image (DMG) above and open it.</li>
          <li>Drag ENG Drawing Viewer onto Applications.</li>
          <li>
            Open the app. Because it's free software that isn't notarized by
            Apple, macOS first says it could not verify it. Click
            <strong>Done</strong>, open <strong>System Settings › Privacy &amp;
            Security</strong>, click <strong>Open Anyway</strong> next to the
            message about ENG Drawing Viewer, and confirm. You only do this once.
          </li>
        </ol>
        <p>
          Please don't turn off Gatekeeper for your whole Mac; Open Anyway is
          enough. Signing: the app has an ad-hoc signature only; it is not
          signed with an Apple Developer ID and not notarized.
        </p>

        <h2>Installing on Windows{win.available && win.preview ? ' (Preview)' : ''}</h2>
        <p>Needs Windows 10 (version 1809 or later) or Windows 11, 64-bit. No administrator rights are needed.</p>
        {winZip || !win.available ? (
          <ol>
            <li>
              Extract the ZIP anywhere: Desktop, Documents or a USB stick.
              Don't run the app from inside the ZIP.
            </li>
            <li>
              Start <code>ENG Drawing Viewer.exe</code> in the extracted
              folder. Keep the <code>app</code> and <code>legal</code> folders
              next to it.
            </li>
            <li>
              The app isn't code-signed, so Windows SmartScreen may say it
              protected your PC. Click <strong>More info</strong>, check that
              it's ENG Drawing Viewer, then <strong>Run anyway</strong>.
            </li>
          </ol>
        ) : (
          <ol>
            <li>
              Download the installer above and run it. It installs for your
              user account only and adds a Start menu shortcut.
            </li>
            <li>
              Because the app isn't code-signed, Windows SmartScreen may say
              it protected your PC. Click <strong>More info</strong>, check
              that the file is ENG Drawing Viewer, then click
              <strong>Run anyway</strong>.
            </li>
            <li>
              Prefer not to install? Unzip the portable ZIP first (don't run
              it from inside the ZIP) and open <code>ENG Drawing Viewer.exe</code>.
            </li>
          </ol>
        )}
        <p>
          HEIC photos in the Viewer need Microsoft's free <em>HEIF Image
          Extensions</em> and <em>HEVC Video Extensions</em> from the Microsoft
          Store; the app tells you if they are missing.
          {win.available && win.preview && ' This is a Preview: it has been built and tested automatically on Windows Server, but not yet on an everyday PC. Please report anything that doesn’t look or work right.'}
        </p>

        <h2>Running on Linux</h2>
        <p>
          {linux.available ? 'The Linux edition is one AppImage file' : 'The Linux edition, coming soon, is one AppImage file'}
          for 64-bit (x86-64) distributions with glibc 2.34 or later: Ubuntu
          22.04, Debian 12, Fedora 35, RHEL / Rocky / AlmaLinux 9, Linux Mint
          21 or newer, on X11 or Wayland.
        </p>
        <ol>
          <li>
            Make it executable: <code>chmod +x ENG-Drawing-Viewer-Linux-x86_64.AppImage</code>,
            or <em>Properties › Permissions › Allow executing file as program</em>.
          </li>
          <li>Double-click it, or run it from a terminal.</li>
          <li>
            Optional: <strong>Help › Add to Applications Menu</strong> adds it
            to your desktop's menu. Add it again if you move the file.
          </li>
        </ol>
        <p>
          AppImages need FUSE (the <code>fuse3</code> package, which desktop
          installations include). Without it, run the file with
          <code>--appimage-extract-and-run</code>. AppImages are not signed;
          check the SHA-256 checksum.
        </p>

        <h2>Verify a download</h2>
        <p>
          Every file has a SHA-256 checksum, shown on its card above and in
          <code>SHA256SUMS.txt</code> on the GitHub release page. Compare the
          whole result:
        </p>
        <ul>
          <li>Mac: <code>shasum -a 256 ~/Downloads/ENG-Drawing-Viewer-*.dmg</code></li>
          <li>Windows (PowerShell): <code>Get-FileHash $HOME\Downloads\ENG-Drawing-Viewer-*</code></li>
          <li>Linux: <code>sha256sum ENG-Drawing-Viewer-Linux-x86_64.AppImage</code></li>
        </ul>
        <p>
          All files, including previous versions, are on the{' '}
          <a href={`${site.appRepo}/releases`}>GitHub releases page ↗</a>.
        </p>

        <h2>Visiting from your phone?</h2>
        <p>
          This is a desktop application. Send this page to your computer when
          you’re ready.
        </p>
        <button class="button" data-share>
          Share this page ↗
        </button>
        <p data-share-status aria-live="polite"></p>

        <h2>Build it yourself</h2>
        <p>
          The complete source code is free under the GNU AGPL v3 or later: the
          source link above, or the{' '}
          <a href={site.appRepo}>repository on GitHub ↗</a>. Release builds are
          made from that published source archive with one command per
          platform, and the unmodified source of every copyleft library inside
          the app is attached to each release.
        </p>
        <p>
          <a href={`${site.appRepo}/issues`}>Questions or problems? Ask on GitHub ↗</a>
        </p>
        <a href={url('support/')} class="text-link">
          Installation questions? Visit support ↗
        </a>
      </div>
    </div>
  </div>
</Layout>
