---
import Layout from '../layouts/Layout.astro';
import Screenshot from '../components/Screenshot.astro';
import { edition, allEditorsReleased, macEditorsReleased, nativeEditorsReleased } from '../data/editions';
const win = edition('windows-x64');
const mac = edition('macos-apple-silicon');
const linux = edition('linux-x86_64');
import pdfeditLight from '../assets/screens/pdfedit-light.png';
import pdfeditDark from '../assets/screens/pdfedit-dark.png';
import imageLight from '../assets/screens/image-light.png';
import imageDark from '../assets/screens/image-dark.png';
import vectorLight from '../assets/screens/vector-light.png';
import vectorDark from '../assets/screens/vector-dark.png';
import queueLight from '../assets/screens/queue-light.png';
import queueDark from '../assets/screens/queue-dark.png';
const newIn = macEditorsReleased ? ' · NEW IN 2.3.0' : ' · COMING IN 2.3.0';
import mainLight from '../assets/screens/main-light.png';
import mainDark from '../assets/screens/main-dark.png';
import markLight from '../assets/screens/mark-light.png';
import markDark from '../assets/screens/mark-dark.png';
import tools from '../data/tools.json';
import { url } from '../data/site';
const categories: Record<string, string> = {
  organize: 'Organize',
  to_pdf: 'Convert to PDF',
  from_pdf: 'Convert from PDF',
  optimize: 'Optimize',
  edit: 'Edit',
  security: 'Security',
  compare: 'Review',
};
---

<Layout
  title="Every detail. One workspace."
  description="Explore sharp PDF viewing, MARK annotations, PowerPoint export, PDF editing, the Image and Vector editors and 32 offline PDF tools in ENG Drawing Viewer."
>
  <div class="container">
    <header class="page-hero">
      <div class="section-tag">A CLOSER LOOK</div>
      <h1>
        Every detail.
        <br />
        <span>One workspace.</span>
      </h1>
      <p>
        A drawing starts a conversation. Find it, review it, convert it and
        share it with the tools that keep your work moving.
      </p>
    </header>
    <div class="page-content">
      <nav class="feature-subnav" aria-label="Feature sections">
        <a href="#view">PDF Viewer</a>
        <a href="#mark">MARK</a>
        <a href="#powerpoint">PowerPoint</a>
        <a href="#edit-pdf">Edit PDF</a>
        <a href="#image">Image</a>
        <a href="#vector">Vector</a>
        <a href="#conversion">Conversion</a>
        <a href="#private">Offline</a>
        <a href="#platforms">Platforms</a>
      </nav>
      <section id="view" class="feature-section">
        <div class="section-tag">01 / PDF VIEWER</div>
        <h2>Big sheets. Fine details.</h2>
        <p>
          Browse nested folders in a tree or a flat list. Natural sorting keeps
          Sheet 2 ahead of Sheet 10. Adjustable thumbnails, file filtering, page
          counts and sheet-size labels help you find the right drawing.
        </p>
        <p>
          Tile-based rendering uses your screen’s pixel density for sharp
          linework. Zoom from 1.5% to 4800%, fit a page or its width, and move
          through multi-page PDFs with the arrow keys. Navigation continues into
          the next drawing.
        </p>
        <p>
          Open a folder or individual files, or simply drag PDFs, images and
          whole folders onto the window, the PowerPoint queue or a PDF tool.
          PNG, JPEG, TIFF, WebP, BMP, GIF and HEIC photos (on Windows with
          Microsoft's free HEIF extensions) open like one-page drawings, upright and at their full resolution, so you can
          MARK a site photo just like a sheet. On Mac, <strong>Scan with
          iPhone</strong> uses Continuity Camera to turn a paper drawing into a
          PDF that opens straight away.
        </p>
        <p>
          Copy the page as a high-resolution image at 150, 220 or 300 DPI, copy
          its filename, or save a PNG.
        </p>
        <Screenshot
          light={mainLight}
          dark={mainDark}
          sizes="(max-width: 900px) 95vw, 760px"
          alt="The real drawing library and viewer, with a sample project in nested folders"
        />
      </section>
      <section id="mark" class="feature-section">
        <div class="section-tag">02 / MARK</div>
        <h2>A review that reads clearly.</h2>
        <p>
          Use pens, highlighters, arrows, outline circles, text, numbered red
          callouts and an eraser. Select, move and restyle annotations. Linked,
          spell-checked comments give every callout context. Undo and redo keep
          exploration easy.
        </p>
        <table class="shortcut-table">
          <thead>
            <tr>
              <th scope="col">Tool</th>
              <th scope="col">Size range</th>
              <th scope="col">Key</th>
            </tr>
          </thead>
          <tbody>
            {[
              ['Pen', '0.25–24 pt', 'P'],
              ['Highlighter', '2–72 pt', 'H'],
              ['Arrow', '0.25–24 pt', 'A'],
              ['Circle', '0.25–24 pt', 'O'],
              ['Text', '4–144 pt', 'T'],
              ['Numbered callout', '8–600 pt', 'B'],
              ['Select / Eraser', '—', 'V / E'],
            ].map(([n, s, k]) => (
              <tr>
                <td>{n}</td>
                <td>{s}</td>
                <td>
                  <kbd>{k}</kbd>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
        <p style="margin-top:25px">
          Live size previews show what will appear on the drawing. Copy a marked
          page at 300 DPI or higher, or save it as a new PDF with vector markup.
          The original PDF stays untouched; temporary annotations should be
          exported before you close.
        </p>
        <a class="text-link" href={url('#mark')}>
          Try the simplified web demo ↗
        </a>
        <Screenshot
          light={markLight}
          dark={markDark}
          sizes="(max-width: 900px) 95vw, 760px"
          alt="The real MARK window with numbered callouts and linked review comments on a sample drawing"
        />
      </section>
      <section id="powerpoint" class="feature-section">
        <div class="section-tag">03 / POWERPOINT</div>
        <h2>Ready for the conversation.</h2>
        <p>
          Queue the current page, selected drawings or marked pages. Reorder
          them and create a new PowerPoint deck, or insert slides into an
          existing deck. PowerPoint itself is not required to generate a .pptx.
        </p>
        <p>
          On marked slides, your drawing sits on the right and editable numbered
          comments sit on the left. Choose 16:9 or 4:3. Add a filename as an
          editable title or subtitle, or leave it off. Export the queue as a
          combined PDF when a deck isn’t what you need.
        </p>
        <Screenshot
          light={queueLight}
          dark={queueDark}
          sizes="(max-width: 900px) 95vw, 760px"
          alt="The real PowerPoint queue holding a marked drawing with its comments and two more sheets"
        />
      </section>
      <section id="edit-pdf" class="feature-section">
        <div class="section-tag">04 / EDIT PDF{newIn}</div>
        <h2>Change the document itself.</h2>
        <p>
          MARK is a temporary review layer; Edit PDF changes real PDF content
          and saves a new file with Save As. Add searchable text, rectangles,
          ellipses, lines, images and PDF notes, then move or resize them
          numerically. Replace or delete an isolated line of original text in a
          standard PDF font, with the drawing underneath preserved.
        </p>
        <p>
          Redaction removes the text, image pixels and touching vector linework
          in a region, rather than covering them. Rotate and crop pages without
          flattening. The whole session has undo and redo; the original stays
          untouched until you save a new PDF.
        </p>
        <div class="callout">
          Limits: original vector drawings, images and form fields can be
          inspected but not reshaped; overlapping or rotated original text is
          refused rather than guessed; replacement text uses standard Latin-1
          PDF fonts; PDFs with signature fields aren't edited. Merging,
          splitting and reordering pages are in PDF Tools.
        </div>
        <Screenshot
          light={pdfeditLight}
          dark={pdfeditDark}
          sizes="(max-width: 900px) 95vw, 760px"
          alt="The real Edit PDF workspace with a box and a revision note added to a sample drawing"
        />
      </section>
      <section id="image" class="feature-section">
        <div class="section-tag">05 / IMAGE EDITOR{newIn}</div>
        <h2>A layered image editor, built in.</h2>
        <p>
          Layers with masks, offsets, opacity and blend modes (normal,
          multiply, screen, overlay). Rectangle, ellipse, lasso and polygonal
          lasso selections, Magic Wand and Quick Selection, with feathering and
          refinement. Brush, highlighter, mask eraser, Magic Eraser, Background
          Eraser, Spot Healing, Clone Stamp and object removal. Crop, resize,
          rotate, flip and canvas size, with rulers, guides and a grid.
        </p>
        <p>
          <strong>Remove background automatically</strong> separates an object
          from a plain or distinct backdrop in one click, using a conventional
          algorithm rather than an AI model. <strong>Select Subject</strong>
          uses an optional, hash-verified ONNX model pack that you install
          yourself; it runs offline and none is bundled.
        </p>
        <p>
          Open PNG, JPEG, TIFF, BMP, WebP, GIF, HEIC and AVIF. Export JPEG,
          PNG, TIFF, WebP, BMP, GIF, AVIF or HEIF, optionally to a target file
          size: the app measures the real encoded bytes. Copy to the clipboard
          as PNG, JPEG, TIFF or BMP with your choice of resolution and
          transparency. Save editable <code>.engimg</code> projects, add
          numbered comments, and send images to the PowerPoint queue.
        </p>
        <div class="callout">
          Up to 80 megapixels and 64 layers per image. Not a Photoshop
          replacement: no RAW development, liquify or advanced typography, and
          colour management is not a complete colour-managed pipeline.
        </div>
        <Screenshot
          light={imageLight}
          dark={imageDark}
          sizes="(max-width: 900px) 95vw, 760px"
          alt="The real Image Editor with a background removed through a layer mask"
        />
      </section>
      <section id="vector" class="feature-section">
        <div class="section-tag">06 / VECTOR EDITOR{newIn}</div>
        <h2>Real geometry, in millimetres.</h2>
        <p>
          Lines, quadratic and cubic Bézier paths, rectangles, ellipses and
          text, with node and handle editing, a pen tool, move, rotate, scale,
          duplicate, group and order. Visible and locked layers, fill, stroke
          and opacity. Boolean union, difference, intersection and exclusion;
          text to outlines; path simplification. Rulers in mm, cm or inches,
          draggable guides, grid snapping and calibration to a known width.
        </p>
        <p>
          <strong>Trace</strong> turns an image into editable paths, side by
          side with the original, with threshold, colour and edge modes,
          background removal, noise removal, smoothing and simplification, and
          presets for laser cutting, laser engraving, vinyl cutting, CAD import
          and illustration. Import and export SVG and DXF; export PDF and PNG;
          save <code>.engvec</code> projects.
        </p>
        <div class="callout">
          A trace is a starting point. Cutting checks report open, duplicate,
          degenerate and crossing contours, but nothing certifies a file for
          production: check scale, kerf, material and machine. SVG support is a
          bounded subset (unsupported effects are reported); DXF curves are
          exported as fine line segments; DWG and G-code are not supported.
        </div>
        <Screenshot
          light={vectorLight}
          dark={vectorDark}
          sizes="(max-width: 900px) 95vw, 760px"
          alt="The real Vector Editor showing a traced outline with its editable points"
        />
      </section>
      <section id="conversion" class="feature-section">
        <span id="pdf-tools"></span>
        <div class="section-tag">07 / CONVERSION &amp; OPTIMIZATION</div>
        <h2>32 tools. All local.</h2>
        <p>
          Organize pages, change formats, prepare a print and compare revisions.
          Every tool creates new output instead of overwriting the input.
        </p>
        <div class="callout">
          Office → PDF needs LibreOffice installed locally. OCR uses Apple
          Vision on Mac. PDF → Word extracts text or page pictures; PDF → Excel
          extracts tables. These tools do not promise perfect reconstruction of
          complex document layouts.
        </div>
        <div class="tools-grid">
          {tools.map((t) => (
            <article class="tool-card">
              <span class="mono">{categories[t.category]}</span>
              <h3>{t.title}</h3>
              <p>{t.description}</p>
            </article>
          ))}
        </div>
        <p style="margin-top:25px">
          PDF → images supports PNG, JPEG and TIFF at 100–600 DPI. Image → PDF
          supports PNG, JPEG, TIFF, BMP, GIF, WebP and HEIC (on Windows with
          Microsoft's free HEIF extensions). PDF → DOCX, XLSX,
          PPTX, TXT and Markdown extract what the PDF contains. Compress
          shrinks drawings for e-mail; the Image Editor exports JPEG, PNG,
          TIFF, WebP, BMP, GIF, AVIF and HEIF, optionally to a target file
          size.
        </p>
        <p>
          Compare highlights removed and added linework and lists text changes.
          Its saved report and queue → PDF output are rasterized.
        </p>
        <p>
          Redact removes matching searchable text and any linework crossing it,
          then also clears the document's metadata, bookmarks, comments,
          attachments, links and form fields; Remove Metadata does the same
          cleanup. Text drawn as lines or inside images can't be found, so check
          the result before you share it.
        </p>
      </section>
      <section id="private" class="feature-section">
        <div class="section-tag">08 / OFFLINE &amp; SAFE</div>
        <h2>Careful with your work.</h2>
        <p>
          Everything happens on your computer: PDF processing, image editing,
          tracing, conversion and PowerPoint generation. There's no account, no
          telemetry and no cloud processing. Optional AI model packs for the
          Image Editor run offline and are never downloaded automatically. The app refuses network connections in its
          own code, in the main window and in every background worker, and its
          automated tests check that this stays true.
        </p>
        <ul>
          <li>Drawings open read-only, and every tool writes a new file. Tools
            refuse to save over an original, even through a shortcut, a link or
            a name that differs only in capitals.</li>
          <li>Saves are atomic: a file is either completely written or left as
            it was, and temporary files are cleaned up.</li>
          <li>PDF → Excel stores a drawing's text as plain text, so nothing in
            it can turn into a live spreadsheet formula or link.</li>
          <li>Protect generates a strong random permissions password when you
            don't set one.</li>
          <li>Extremely large pages and images are checked before memory is
            used, so a damaged or extreme file can't exhaust your computer;
            PDF → Images lowers the resolution for oversized sheets and tells
            you.</li>
          <li>Conversions that use LibreOffice run in their own contained
            process and are stopped completely if they take too long.</li>
        </ul>
        <p>
          ENG Drawing Viewer is free software under the GNU AGPL v3 or later.
          Help › About shows the licence, the third-party notices and where to
          get the source code.
        </p>
      </section>
      <section id="platforms" class="feature-section">
        <div class="section-tag">PLATFORMS</div>
        <h2>Four editions. One app.</h2>
        <p>
          The same workspaces on every edition, built from one source. What
          differs is how each fits in with its system.
        </p>
        <table class="shortcut-table">
          <thead>
            <tr>
              <th scope="col">Capability</th>
              <th scope="col">Mac</th>
              <th scope="col">Windows</th>
              <th scope="col">Linux</th>
            </tr>
          </thead>
          <tbody>
            {[
              ['Editions', 'Universal (Intel + Apple silicon), Apple Silicon', 'x64', 'x86-64 AppImage'],
              ['Requires', 'macOS 14.4+', 'Windows 10 (1809+) or 11', 'glibc 2.34+'],
              ['Viewer, MARK, PDF Tools, PowerPoint, editors', 'Yes', 'Yes', 'Yes'],
              ['Scan with iPhone', 'Continuity Camera', '—', '—'],
              ['Send slides to an open PowerPoint', 'Yes', 'Yes', '—'],
              ['OCR (Make Searchable)', 'Apple Vision', 'Bundled Tesseract (7 languages)', 'Bundled Tesseract (7 languages)'],
              ['HEIC photos in the Viewer', 'Built in', "Microsoft's free HEIF/HEVC extensions", 'Bundled libheif'],
              ['Spelling in comments', 'macOS spelling', 'Windows spelling', 'Built-in English'],
              ['Signing', 'Ad hoc, not notarized', 'Not code-signed', 'SHA-256 checksums'],
            ].map(([a, b, c, d]) => (
              <tr>
                <td>{a}</td>
                <td>{b}</td>
                <td>{c}</td>
                <td>{d}</td>
              </tr>
            ))}
          </tbody>
        </table>
        <p style="margin-top:25px">
          {mac.available ? `Available now: Mac Apple Silicon ${mac.version}` : 'Nothing is released yet'}
          {win.available ? `, Windows ${win.version}${win.preview ? ' Preview' : ''}` : ''}
          {linux.available ? `, Linux ${linux.version}` : ''}.
          {allEditorsReleased ? '' : nativeEditorsReleased ? ' A Universal Mac edition is coming soon.' : ' Windows and Linux 2.3.0, with the editors, are being finished; a Universal Mac edition is coming soon.'}
          Windows and Linux are tested automatically; hands-on testing on
          everyday PCs and Linux desktops is ongoing.
        </p>
        <a class="text-link" href={url('download/')} style="margin-top:25px">
          Choose your edition ↗
        </a>
      </section>
    </div>
  </div>
</Layout>
