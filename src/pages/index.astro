---
import HeroScene from '../components/HeroScene.astro';
import Layout from '../layouts/Layout.astro';
import Drawing from '../components/Drawing.astro';
import Downloads from '../components/Downloads.astro';
import ReviewStory from '../components/ReviewStory.astro';
import { Image } from 'astro:assets';
import icon from '../assets/icon.png';
import Screenshot from '../components/Screenshot.astro';
import mainDark from '../assets/screens/main-dark.png';
import mainLight from '../assets/screens/main-light.png';
import markLight from '../assets/screens/mark-light.png';
import markDark from '../assets/screens/mark-dark.png';
import toolsLight from '../assets/screens/tools-light.png';
import toolsDark from '../assets/screens/tools-dark.png';
import compareLight from '../assets/screens/compare-light.png';
import compareDark from '../assets/screens/compare-dark.png';
import queueLight from '../assets/screens/queue-light.png';
import queueDark from '../assets/screens/queue-dark.png';
import pdfeditLight from '../assets/screens/pdfedit-light.png';
import pdfeditDark from '../assets/screens/pdfedit-dark.png';
import imageLight from '../assets/screens/image-light.png';
import imageDark from '../assets/screens/image-dark.png';
import vectorLight from '../assets/screens/vector-light.png';
import vectorDark from '../assets/screens/vector-dark.png';
import { url } from '../data/site';
import { edition, allEditorsReleased, macEditorsReleased, nativeEditorsReleased } from '../data/editions';
import demo from '../data/demo.json';
const win = edition('windows-x64');
const linux = edition('linux-x86_64');
const platforms = linux.available ? 'Mac, Windows and Linux' : win.available ? 'Mac and Windows, with Linux on the way' : 'Mac, with Windows and Linux on the way';
const kb = (n: number) => `${Math.round(n / 1000)} KB`;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const demoFile = (f: string) => `${base}/demo/${f}`;
// The traced outline's editable points, for the vector animation (from the app's own SVG export).
const nodes = demo.trace.paths
  .join(' ')
  .match(/[ML]\s*[-\d.]+\s+[-\d.]+/g)!
  .map((m) => m.slice(1).trim().split(/\s+/).map(Number));
const [bx0, by0, bx1, by1] = demo.trace.bbox_mm;
const traceSteps = ['Raster', 'Edges', 'Trace', 'Nodes', 'Refine', 'Vector', 'Export'];
const universal = edition('macos-universal');
const editorsNote = allEditorsReleased || nativeEditorsReleased ? 'New in version 2.3.0' : macEditorsReleased ? 'New in version 2.3.0 · On Mac now' : 'Coming in version 2.3.0';
---

<Layout>
  <section class="hero container">
    <div class="hero-opening">
      <div class="hero-editorial">
        <h1>
          Every detail.
          <br />
          <span>Clearly.</span>
        </h1>
        <p class="hero-copy">
          View, annotate, edit, convert and present engineering drawings with
          precision. <br class="desktop" />A powerful offline workspace for {platforms}.
        </p>
        <div class="hero-actions">
          <a class="button" href={url('download/')}>
            Download for free <span aria-hidden="true">↗</span>
          </a>
          <a class="text-link" href="#viewer">
            Explore the details <span aria-hidden="true">↓</span>
          </a>
        </div>
      </div>
      <HeroScene />
    </div>
    <div class="hero-product">
      <Screenshot
        class="hero-window"
        dark={mainDark}
        eager
        sizes="(max-width: 800px) 95vw, 1200px"
        alt="The real ENG Drawing Viewer application on macOS, showing a sample project's folder tree, a bearing flange drawing and page thumbnails"
      />
      <span class="product-caption mono">
        ACTUAL APPLICATION · SAMPLE DRAWINGS
      </span>
    </div>
  </section>
  <section id="workspace" class="intro container section">
    <div class="section-heading">
      <h2>
        Less friction.
        <br />
        <span>More flow.</span>
      </h2>
      <p>
        One thoughtful workspace for the work around your drawings. Open a
        folder, find the detail, make your point, and send it on.
      </p>
    </div>
    <div class="feature-grid">
      {[
        ['01', 'View', 'Find the drawing. See every detail.', 'viewer'],
        ['02', 'MARK', 'Make the next review unmistakable.', 'mark'],
        ['03', 'Present', 'From drawing to discussion.', 'present'],
        ['04', 'Edit', 'PDFs, images and vectors. Still local.', 'edit-pdf'],
      ].map(([n, t, d, id]) => (
        <a class="feature-tile" href={`#${id}`}>
          <span class="mono">
            {n} <span>↗</span>
          </span>
          <h3>{t}</h3>
          <p>{d}</p>
          <div class={`tile-art art-${id}`} aria-hidden="true">
            {id === 'viewer' ? (
              '⌖'
            ) : id === 'mark' ? (
              <span class="red-bubble">1</span>
            ) : id === 'present' ? (
              <span>▱ ▱ ▱</span>
            ) : (
              <span>
                PDF <b>·</b> IMG <b>·</b> SVG
              </span>
            )}
          </div>
        </a>
      ))}
    </div>
  </section>
  <section id="viewer" class="section viewer-section">
    <div class="container">
      <div class="section-heading">
        <h2>
          Every hairline.
          <br />
          <span>At every zoom.</span>
        </h2>
        <p>
          Dense sheets deserve a clear view. Tile-based rendering keeps fine
          linework crisp as you move from the whole picture to the smallest
          detail.
        </p>
      </div>
      <div class="zoom-demo">
        <div class="demo-top">
          <span class="mono">Turbine / blade detail</span>
          <output id="zoom-value" for="zoom">
            100%
          </output>
        </div>
        <div class="zoom-drawing">
          <div data-zoom-sheet>
            <Drawing id="zoom" />
          </div>
        </div>
        <div class="zoom-controls">
          <span>−</span>
          <input
            id="zoom"
            aria-label="Illustrative drawing zoom"
            type="range"
            min="100"
            max="800"
            value="100"
          />
          <span>+</span>
          <span class="mono">INTERACTIVE ILLUSTRATION</span>
        </div>
      </div>
      <div class="spec-strip">
        <div>
          <strong>
            1.5–4800<span>%</span>
          </strong>
          <p>Real application zoom range</p>
        </div>
        <div>
          <strong>
            A0 <span>to</span> A5
          </strong>
          <p>Plus ANSI sheet recognition</p>
        </div>
        <div>
          <strong>150 / 220 / 300</strong>
          <p>DPI clipboard copies</p>
        </div>
      </div>
      <p class="center subtle">
        Nested folders. Multiple PDFs. Adjustable thumbnails. Multi-page
        navigation, panning and drag and drop. A library that keeps up.
      </p>
    </div>
  </section>
  <section id="mark" class="section container">
    <div class="section-heading">
      <h2>
        A clear thought.
        <br />
        <span class="red-text">A precise mark.</span>
      </h2>
      <p>
        Pen, highlight, circle, arrow. Add numbered callouts with linked
        comments. Undo, refine, and copy your review. The original PDF stays
        untouched.
      </p>
    </div>
    <div class="mark-playground" data-mark>
      <div class="demo-top">
        <span class="mono">
          TRY MARK <span class="subtle">/ SIMPLIFIED WEB DEMO</span>
        </span>
        <span class="original-safe">Original protected ✓</span>
      </div>
      <div
        class="mark-toolbar"
        role="toolbar"
        aria-label="Demo annotation tools"
      >
        {[
          ['select', '↖', 'Select (V)'],
          ['pen', '〰', 'Pen (P)'],
          ['highlighter', '▰', 'Highlighter (H)'],
          ['arrow', '↗', 'Arrow (A)'],
          ['circle', '○', 'Circle (O)'],
          ['text', 'T', 'Text (T)'],
          ['bubble', '①', 'Callout (B)'],
          ['eraser', '⌫', 'Eraser (E)'],
        ].map(([t, s, l]) => (
          <button
            data-tool={t}
            aria-label={l}
            aria-pressed={t === 'bubble'}
            title={l}
          >
            {s}
          </button>
        ))}
        <span class="toolbar-divider"></span>
        <label class="color-label">
          Colour{' '}
          <input type="color" value="#1e5adc" aria-label="Annotation colour" />
        </label>
        <label class="size-label">
          Size{' '}
          <input
            type="range"
            min="2"
            max="40"
            value="14"
            aria-label="Annotation size"
          />
        </label>
        <button data-undo aria-label="Undo annotation" title="Undo">
          ↶
        </button>
        <button data-redo aria-label="Redo annotation" title="Redo">
          ↷
        </button>
        <button data-clear>Clear</button>
      </div>
      <div class="mark-stage">
        <div
          class="mark-sheet"
          tabindex="0"
          role="group"
          aria-label="Sample drawing. Click to annotate, or press Enter to add a callout in the centre."
        >
          <Drawing id="playground" interactive />
        </div>
        <aside class="mark-comments">
          <span class="mono">REVIEW NOTES</span>
          <p data-empty>
            Choose a tool. Click the drawing.
            <br />
            Make the detail speak.
          </p>
          <ol data-comments></ol>
          <p class="demo-hint">
            Callouts and comments are linked. Your demo stays in this tab.
          </p>
        </aside>
      </div>
      <p class="sr-only" aria-live="polite" data-mark-status></p>
    </div>
    <div class="mark-foot">
      <p>
        <span class="red-bubble small-bubble">1</span> A number on the sheet. A
        thought beside it.
      </p>
      <span class="mono"></span>
    </div>
    <div class="mark-shot">
      <Screenshot
        light={markLight}
        dark={markDark}
        alt="The real MARK window: a sample drawing with a circle, an arrow, a highlight and four numbered callouts linked to review comments"
      />
      <p class="product-caption mono">MARK in the app · live size previews · select, restyle, delete · copy at 300 DPI</p>
    </div>
  </section>
  <section id="present" class="section container">
    <div class="section-heading">
      <h2>
        From markup
        <br />
        <span>to meeting.</span>
      </h2>
      <p>
        Queue your pages. Arrange your story. Export to PowerPoint with your
        drawing on the right and editable numbered comments on the left.
      </p>
    </div>
    <ReviewStory />
    <div class="spec-strip">
      <div>
        <strong>No Office needed</strong>
        <p>Write .pptx files locally</p>
      </div>
      <div>
        <strong>Editable comments</strong>
        <p>Your notes stay useful</p>
      </div>
      <div>
        <strong>Your workflow</strong>
        <p>New deck or existing presentation</p>
      </div>
    </div>
    <div class="queue-shot">
      <Screenshot
        light={queueLight}
        dark={queueDark}
        alt="The real PowerPoint queue in ENG Drawing Viewer, holding a MARKed flange drawing with four comments, a drive shaft and a mounting bracket"
      />
      <p class="product-caption mono">The PowerPoint queue in the app · Sample drawings</p>
    </div>
  </section>

  <div class="workspaces-intro container" id="editors">
    {editorsNote && <span class="new-pill">{editorsNote}</span>}
    <h2>
      Three new workspaces.
      <br />
      <span>One familiar app.</span>
    </h2>
    <p>
      Edit PDF, Image and Vector sit on their own tabs beside the Viewer and PDF
      Tools. They work on your computer, like everything else.
      {!nativeEditorsReleased && macEditorsReleased && ' Windows and Linux get them with their 2.3.0 editions.'}
    </p>
  </div>

  <section id="edit-pdf" class="section editor-section">
    <div class="container">
      <div class="section-heading">
        <span class="section-tag">EDIT PDF</span>
        <h2>
          When a markup
          <br />
          <span>isn’t enough.</span>
        </h2>
        <p>
          MARK adds a temporary review layer and never touches the original.
          Edit PDF changes the document itself and saves a new PDF, with undo
          for the whole session.
        </p>
      </div>
      <div class="compare-modes">
        <div>
          <span class="mono">MARK</span>
          <h3>Review</h3>
          <p>Pens, highlights, numbered callouts and comments over the page. Copy, queue or save a marked copy.</p>
        </div>
        <div class="vs" aria-hidden="true">≠</div>
        <div>
          <span class="mono">EDIT PDF</span>
          <h3>Change</h3>
          <p>Real PDF content: searchable text, shapes, images, notes, redaction, rotation and crop. Saved with Save As.</p>
        </div>
      </div>
      <div class="editor-shot">
        <Screenshot
          light={pdfeditLight}
          dark={pdfeditDark}
          alt="The real Edit PDF workspace: a sample bearing flange drawing with a red box and a revision note added as PDF content, the toolbar for selecting content, replacing text and rotating pages, and a list of the page's text spans"
        />
        <p class="product-caption mono">Edit PDF in the app · a box and a revision note added as real PDF content</p>
      </div>
      <ul class="capability-list">
        <li><strong>Add</strong> searchable text, rectangles, ellipses, lines, images and PDF notes; move and resize them numerically.</li>
        <li><strong>Replace</strong> an isolated line of original text in a standard PDF font, keeping the drawing underneath.</li>
        <li><strong>Redact</strong> a region for real: its text, image pixels and touching linework are removed, not covered.</li>
        <li><strong>Pages</strong>: rotate and crop without flattening. Merge, split, reorder and more live in PDF Tools.</li>
      </ul>
      <p class="fine-print center">
        Original PDFs don’t carry an editable design structure: original
        vector linework, images and form fields can be inspected but not
        reshaped, and replacement text uses standard Latin-1 PDF fonts.
      </p>
    </div>
  </section>

  <section id="image" class="section editor-section">
    <div class="container">
      <div class="section-heading">
        <span class="section-tag">IMAGE EDITOR</span>
        <h2>
          More than drawings.
          <br />
          <span>Edit every detail.</span>
        </h2>
        <p>
          Site photos, product shots, scans. A layered image editor with
          selections, masks, healing and exports sized to fit, without leaving
          your drawings.
        </p>
      </div>
      <div class="cutout-demo" data-cutout style="--split:50%">
        <img
          class="cutout-before"
          src={demoFile(demo.sample.file)}
          width={demo.sample.width}
          height={demo.sample.height}
          alt="Sample image: a rendered CNC-machined aluminium bearing bracket on a blue studio backdrop"
          loading="lazy"
          decoding="async"
        />
        <div class="cutout-after">
          <img
            src={demoFile(demo.background_removal.file)}
            width={demo.sample.width}
            height={demo.sample.height}
            alt="The same image after the app's automatic background removal: the bracket on transparency"
            loading="lazy"
            decoding="async"
          />
        </div>
        <svg
          class="selection-ants"
          viewBox={`0 0 ${demo.sample.width} ${demo.sample.height}`}
          aria-hidden="true"
          preserveAspectRatio="xMidYMid slice"
        >
          <path d={demo.quick_selection.outline} />
        </svg>
        <div class="cutout-handle" aria-hidden="true"><span><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M2 12h20M6 8l-4 4 4 4M18 8l4 4-4 4" /></svg></span></div>
        <input
          class="cutout-range"
          type="range"
          min="0"
          max="100"
          value="50"
          aria-label="Compare the original with the background removed"
        />
        <span class="cutout-label left mono">ORIGINAL</span>
        <span class="cutout-label right mono">BACKGROUND REMOVED</span>
      </div>
      <div class="demo-switch" role="group" aria-label="Image demonstration">
        <button aria-pressed="true" data-cutout-mode="remove">Remove background</button>
        <button aria-pressed="false" data-cutout-mode="select">Quick Selection</button>
      </div>
      <p class="demo-caption" data-cutout-caption>
        Real output of the app’s one-click <em>Remove background automatically</em>,
        with a 1 px feather from <em>Select › Feather / grow / smooth</em>. It is a
        conventional algorithm, not an AI model: it suits objects on a plain or
        distinct backdrop.
      </p>
      <div class="tool-cloud" aria-label="Image Editor tools">
        {[
          'Layers & masks', 'Rectangle & ellipse selection', 'Lasso & polygonal lasso', 'Magic Wand',
          'Quick Selection', 'Magic Eraser', 'Background Eraser', 'Spot Healing', 'Clone Stamp',
          'Object removal', 'Crop, resize, rotate, flip', 'Rulers, guides & grid', 'Brush & highlighter',
          'Text, shapes & numbered comments', 'Blend modes', 'Native clipboard formats',
        ].map((t) => (
          <span>{t}</span>
        ))}
      </div>
      <div class="compress-demo" data-compress>
        <div class="compress-view">
          {demo.exports.map((e, i) => (
            <img
              src={demoFile(e.file)}
              width={e.width}
              height={e.height}
              alt={`JPEG exported by the app: ${e.width} × ${e.height} pixels, quality ${e.quality}, ${kb(e.bytes)}`}
              loading="lazy"
              decoding="async"
              data-export={i}
              hidden={i !== 0}
            />
          ))}
        </div>
        <div class="compress-panel">
          <span class="mono">EXPORT TO A FILE SIZE</span>
          <h3>Small enough to send.</h3>
          <p>
            Set a target and the app searches the quality, and optionally the
            dimensions, measuring the real encoded file every time.
          </p>
          <div class="compress-options" role="radiogroup" aria-label="Target file size">
            {demo.exports
              .filter((e, i) => i !== 1 || e.bytes !== demo.exports[0].bytes)
              .map((e) => {
                const i = demo.exports.indexOf(e);
                return (
                  <button role="radio" aria-checked={i === 0} data-target={i}>
                    {e.target_bytes ? `Under ${kb(e.target_bytes)}` : 'Best quality'}
                  </button>
                );
              })}
          </div>
          <div class="compress-stats">
            {demo.exports.map((e, i) => (
              <dl data-stats={i} hidden={i !== 0}>
                <div><dt>File size</dt><dd>{kb(e.bytes)}</dd></div>
                <div><dt>Pixels</dt><dd>{e.width} × {e.height}</dd></div>
                <div><dt>JPEG quality</dt><dd>{e.quality}</dd></div>
              </dl>
            ))}
          </div>
          <p class="fine-print">
            Each picture is the unchanged file the app exported. Exports:
            JPEG, PNG, TIFF, WebP, BMP, GIF, AVIF and HEIF.
          </p>
        </div>
      </div>
      <div class="editor-shot">
        <Screenshot
          light={imageLight}
          dark={imageDark}
          alt="The real Image Editor: the sample aluminium bracket with its background removed through a layer mask, on a transparency checkerboard, with the tool column, the Quick Selection settings and the Layers panel"
        />
        <p class="product-caption mono">The Image Editor in the app · background hidden by a layer mask, fully reversible</p>
      </div>
      <p class="fine-print center">
        The sample is an original, opaque render of a fictional part, made with
        CAD and Blender. Opens PNG, JPEG, TIFF, BMP, WebP, GIF, HEIC and AVIF. AI <em>Select
        Subject</em> works with an optional model pack you install yourself and
        that runs offline; none is bundled. Up to 80 megapixels and 64 layers
        per image; saved as an editable <code>.engimg</code> project.
      </p>
    </div>
  </section>

  <section id="vector" class="section editor-section vector-section">
    <div class="container">
      <div class="section-heading">
        <span class="section-tag">VECTOR EDITOR</span>
        <h2>
          From pixels
          <br />
          <span>to precision.</span>
        </h2>
        <p>
          Draw and edit real geometry in millimetres. Trace a raster outline
          into editable paths, then export SVG or DXF for your cutter, CAD or
          illustration tool.
        </p>
      </div>
      <div class="trace-demo" data-trace data-step="6">
        <div class="trace-stage">
          <img
            class="trace-source"
            src={demoFile(demo.trace.source_file)}
            width="1600"
            height="693"
            alt="The traced picture: an original render of a digital caliper, opaque, on a light backdrop"
            loading="lazy"
            decoding="async"
          />
          <img class="trace-layer trace-edges" src={demoFile('caliper-edges.svg')} alt="" width="1200" height="520" loading="lazy" decoding="async" />
          <img class="trace-layer trace-raw" src={demoFile('caliper-raw.svg')} alt="" width="1200" height="520" loading="lazy" decoding="async" />
          <svg viewBox={demo.trace.viewBox} role="img" aria-label={`The traced caliper: ${demo.trace.contours} closed contours with ${demo.trace.nodes} editable points, ${demo.trace.width_mm} by ${demo.trace.height_mm} millimetres`}>
            {demo.trace.paths.map((d) => (
              <path class="trace-fill" d={d} fill-rule="evenodd" />
            ))}
            {demo.trace.paths.map((d) => (
              <path class="trace-path" d={d} pathLength="1" />
            ))}
            <g class="trace-nodes">
              {nodes.map(([x, y], i) => (
                <circle cx={x} cy={y} r="0.85" style={`--d:${(i / nodes.length).toFixed(3)}`} />
              ))}
            </g>
            <g class="trace-dims">
              <path d={`M${bx0} ${by1 + 2}V${by1 + 11} M${bx1} ${by1 + 2}V${by1 + 11} M${bx0} ${by1 + 9}H${bx1}`} />
              <path d={`M${bx1 + 2} ${by0}H${bx1 + 5.5} M${bx1 + 2} ${by1}H${bx1 + 5.5} M${bx1 + 4} ${by0}V${by1}`} />
              <text x={(bx0 + bx1) / 2} y={by1 + 15} text-anchor="middle">{demo.trace.width_mm} mm</text>
              <text transform={`translate(${bx1 + 3.2} ${(by0 + by1) / 2 + 18}) rotate(-90)`}>{demo.trace.height_mm} mm</text>
            </g>
          </svg>
        </div>
        <div class="trace-steps" role="group" aria-label="Steps from raster to vector">
          {traceSteps.map((label, i) => (
            <button type="button" data-trace-step={i} aria-pressed={i === 6}>{label}</button>
          ))}
        </div>
        <div class="trace-panel">
          <dl class="trace-facts">
            <div><dt>Closed contours</dt><dd>{demo.trace.contours}</dd></div>
            <div><dt>Editable points</dt><dd data-trace-count data-raw={demo.trace.raw_nodes} data-final={demo.trace.nodes}>{demo.trace.nodes}</dd></div>
            <div><dt>Traced size</dt><dd>{demo.trace.width_mm} × {demo.trace.height_mm} mm</dd></div>
          </dl>
          <div class="trace-side">
            <div class="export-chips" aria-label="Vector export files">
              <a href={demoFile(demo.trace.svg_file)} download>SVG · {(demo.trace.svg_bytes / 1000).toFixed(1)} KB ↓</a>
              <a href={demoFile(demo.trace.dxf_file)} download>DXF · {(demo.trace.dxf_bytes / 1000).toFixed(1)} KB ↓</a>
              <span>PDF</span>
              <span>PNG</span>
            </div>
            <button class="text-link" data-trace-replay>Replay the trace ↻</button>
          </div>
          <p class="fine-print">
            Real output of the app’s tracing and export, and the files are yours
            to open. The picture is an original render at {demo.trace.pixels_per_mm} pixels per
            millimetre of a {demo.trace.model_mm[0]} × {demo.trace.model_mm[1]} mm model. Small print
            on the display fell below the trace’s noise filter, and refining took
            the outline from {demo.trace.raw_nodes.toLocaleString('en-GB')} points to {demo.trace.nodes}. Traces are
            straight segments that follow curves closely.
          </p>
        </div>
      </div>
      <div class="editor-shot">
        <Screenshot
          light={vectorLight}
          dark={vectorDark}
          alt="The real Vector Editor: the traced digital caliper selected with the node tool, its points shown, with millimetre rulers, the geometry panel, the Trace layer and the Export button; the status bar reads selection 284.12 × 70.62 mm"
        />
        <p class="product-caption mono">The Vector Editor in the app · the same trace · millimetre rulers, nodes, layers, SVG and DXF export</p>
      </div>
      <ul class="capability-list">
        <li><strong>Draw</strong> lines, Bézier paths, rectangles, ellipses and text; edit nodes and handles.</li>
        <li><strong>Combine</strong> with union, difference, intersection and exclusion; group, align, layer, lock.</li>
        <li><strong>Measure</strong> in mm, cm or inches with rulers, guides, grid snapping and calibration to a known width.</li>
        <li><strong>Trace</strong> with presets for laser cutting, engraving, vinyl, CAD import and illustration, side by side with the original.</li>
      </ul>
      <p class="fine-print center">
        A trace is a starting point, not a finished cutting file. Cutting checks
        warn about open, duplicate and crossing paths, but you still check
        scale, kerf and your machine. Photographs can trace poorly. No G-code;
        DWG is not supported.
      </p>
    </div>
  </section>

  <section id="convert" class="section convert-section">
    <div class="container">
      <div class="section-heading">
        <h2>
          New format.
          <br />
          <span>Same computer.</span>
        </h2>
        <p>
          Move between drawings, documents and images without sending your work
          away. A complete PDF Tools workspace, with 32 tools in seven groups.
        </p>
      </div>
      <div class="converter" data-converter>
        <div>
          <span class="mono">START WITH</span>
          <div class="file-tile">
            PDF<span>.pdf</span>
          </div>
        </div>
        <div class="conversion-path" aria-hidden="true">
          <span></span>→<span></span>
        </div>
        <div>
          <span class="mono">MAKE IT</span>
          <div
            class="format-options"
            role="group"
            aria-label="Preview PDF conversion formats"
          >
            {['DOCX', 'XLSX', 'PPTX', 'PNG', 'TXT'].map((f, i) => (
              <button data-format={f} aria-pressed={i === 0}>
                {f}
              </button>
            ))}
          </div>
        </div>
        <p data-format-description aria-live="polite">
          Editable text or page pictures in a Word document.
        </p>
      </div>
      <div class="tool-teaser">
        <div>
          <h3>
            Your PDF toolbox.
            <br />
            Thoughtfully in one place.
          </h3>
          <p>Organize · Convert · Optimize · Edit · Protect · Review</p>
          <p>
            Merge, split, compress, make searchable, convert images to PDF and
            back. Drag files straight onto a tool. On paper? Scan the drawing
            with your iPhone (Mac) and it opens as a PDF, ready to mark up.
          </p>
          <a class="text-link" href={url('features/#conversion')}>
            Explore all 32 tools ↗
          </a>
          <p class="fine-print">
            Office → PDF requires a local LibreOffice installation. Conversion
            fidelity depends on the document.
          </p>
        </div>
        <Screenshot
          light={toolsLight}
          dark={toolsDark}
          sizes="(max-width: 900px) 95vw, 640px"
          alt="The real PDF Tools workspace with tools grouped into Organize, Convert, Optimize and more"
        />
      </div>
      <div class="tool-teaser tool-teaser--flip">
        <Screenshot
          light={compareLight}
          dark={compareDark}
          sizes="(max-width: 900px) 95vw, 640px"
          alt="The real Compare Drawings tool overlaying revision B and C of a sample flange: removed lines in red, added in blue, changed areas boxed, text changes listed"
        />
        <div>
          <h3>
            Rev B or Rev C?
            <br />
            See exactly what changed.
          </h3>
          <p>
            Compare Drawings overlays two revisions. Removed lines turn red,
            added lines blue, changed areas are boxed and text changes are
            listed beside the sheet.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section id="platforms" class="section container platforms-section">
    <div class="section-heading">
      <h2>
        One workspace.
        <br />
        <span>Every desk.</span>
      </h2>
      <p>
        {allEditorsReleased || nativeEditorsReleased
          ? 'The same Viewer, MARK, PowerPoint export, PDF Tools and editors on every edition, built from one source, each fitting in with its system.'
          : 'One app built from one source, fitting in with each system. The editors are on Mac now and reach Windows and Linux with their 2.3.0 editions.'}
      </p>
    </div>
    <div class="platform-tabs" role="tablist" aria-label="Platforms">
      {['macOS', 'Windows', 'Linux'].map((p, i) => (
        <button role="tab" id={`tab-${p}`} aria-controls={`panel-${p}`} aria-selected={i === 0} tabindex={i === 0 ? 0 : -1} data-platform-tab={p}>
          {p}
        </button>
      ))}
    </div>
    <div class="platform-panels">
      <div class="platform-panel" id="panel-macOS" role="tabpanel" aria-labelledby="tab-macOS">
        <Screenshot
          light={mainLight}
          dark={mainDark}
          sizes="(max-width: 900px) 95vw, 1000px"
          alt="ENG Drawing Viewer on macOS, a real screenshot"
        />
        <ul class="platform-notes">
          <li>{universal.available ? 'Universal (Intel + Apple silicon) and a dedicated Apple Silicon edition' : 'A native Apple Silicon edition today; a Universal edition for Intel Macs is coming soon'}</li>
          <li>Scan with iPhone through Continuity Camera; OCR with Apple Vision</li>
          <li>Send slides into a presentation open in PowerPoint, or export a .pptx file</li>
          <li>macOS spelling, native menus and trackpad gestures</li>
        </ul>
      </div>
      {[
        ['Windows', '⊞', ['Portable: unzip and run, no administrator rights', 'Send slides into a presentation open in PowerPoint', 'Windows spelling; OCR with bundled Tesseract data (7 languages)', 'Title bars follow light and dark mode']],
        ['Linux', '◆', ['One AppImage for x86-64 with glibc 2.34 or later', 'Native Wayland or X11; desktop-portal file dialogs', 'Help › Add to Applications Menu', 'HEIC through bundled libheif; OCR with bundled Tesseract data']],
      ].map(([p, sym, notes]) => (
        <div class="platform-panel" id={`panel-${p}`} role="tabpanel" aria-labelledby={`tab-${p}`} hidden>
          <div class="platform-placeholder" aria-hidden="true">
            <span class="platform-glyph">{sym}</span>
            <span class="mono">{p === 'Windows' ? 'WINDOWS 10 · 11 · x64' : 'UBUNTU · DEBIAN · FEDORA · RHEL'}</span>
          </div>
          <ul class="platform-notes">
            {(notes as string[]).map((n) => <li>{n}</li>)}
          </ul>
          <p class="fine-print">
            Screenshots of the {p} edition will appear here once they are taken
            on a real {p} desktop. Until then, we only show what we have
            verified.
          </p>
        </div>
      ))}
    </div>
  </section>

  <section class="privacy-section section">
    <div class="container privacy-content">
      <div>
        <h2>
          Your files.
          <br />
          <span>Your computer.</span>
        </h2>
        <p>
          Engineering work deserves a private workspace. PDFs, images, vectors
          and presentations are processed on your computer, without accounts,
          cloud uploads or telemetry.
        </p>
        <ul class="privacy-points">
          <li>
            <strong>Offline by design.</strong> The app refuses network
            connections in its own code, and its tests check it.
          </li>
          <li>
            <strong>Offline AI, if you want it.</strong> Optional model packs
            run on your computer. Nothing is downloaded automatically.
          </li>
          <li>
            <strong>Originals stay untouched.</strong> Drawings open
            read-only; tools and editors write new files.
          </li>
          <li>
            <strong>Share with care.</strong> Redact and Remove Metadata also
            clear bookmarks, comments, attachments, links and form fields.
          </li>
        </ul>
        <a class="text-link" href={url('privacy/')}>
          A little more about privacy ↗
        </a>
      </div>
      <div class="offline-diagram" aria-hidden="true">
        <div class="orbit"></div>
        <div class="computer">
          <Image densities={[1, 2]} src={icon} width={72} height={72} alt="" />
          <span class="mono">LOCAL WORKSPACE</span>
          <div class="local-files">PDF · MARK · PPTX · IMG · SVG</div>
        </div>
        <span class="offline-note mono"></span>
      </div>
    </div>
  </section>
  <section class="section container final-download">
    <Image
      densities={[1, 2]}
      src={icon}
      width={86}
      height={86}
      alt="ENG Drawing Viewer blue application icon"
    />
    <h2>
      Make room
      <br />
      <span>for better work.</span>
    </h2>
    <p>
      Free and open source, for {platforms}.
    </p>
    <Downloads compact />
    <a class="text-link" href={url('download/')}>
      Checksums, release details and installation ↗
    </a>
  </section>
